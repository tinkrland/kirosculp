{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sculptura.dev/schemas/profile.schema.json",
  "title": "paracraft manufacturing profile",
  "description": "a versioned manufacturing profile: scoped constraints, profile parameters, and capabilities, every value carrying evidence lineage into research/evidence/evidence.jsonl. candidate format for paracraft's rule JSON.",
  "type": "object",
  "required": ["profile_id", "name", "version", "created", "scope", "constraints", "source_lineage"],
  "additionalProperties": false,
  "properties": {
    "profile_id": { "type": "string", "pattern": "^profile-\\d+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "created": { "type": "string", "format": "date" },
    "scope": {
      "type": "object",
      "required": ["process", "material", "manufacturer"],
      "additionalProperties": false,
      "properties": {
        "process": { "type": "string" },
        "material": { "type": "string" },
        "manufacturer": { "type": "string" },
        "machine": { "type": "string" },
        "orientation": { "type": "string" },
        "finishing": { "type": "string" }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["constraint_id", "property", "operator", "value", "unit", "severity", "evidence"],
        "additionalProperties": true,
        "properties": {
          "constraint_id": { "type": "string", "pattern": "^ctr-[a-z0-9]+-\\d+$" },
          "property": { "type": "string", "minLength": 1 },
          "operator": { "enum": [">=", "<=", "==", "!="] },
          "value": { "type": ["number", "string", "boolean", "object", "array"] },
          "unit": { "type": "string" },
          "severity": { "enum": ["error", "warning", "informational"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^evid-[a-z0-9-]+$" }
          },
          "measurement": {
            "type": "object",
            "properties": {
              "method": { "type": "string" },
              "inputs": { "type": "string" }
            }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "parameters": {
      "type": "object",
      "description": "process parameters that are not geometric constraints (shrinkage, erosion, tolerance). loose on purpose until paracraft fixes the shapes.",
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "description": "manufacturer capability flags and notes.",
      "additionalProperties": true
    },
    "unsupported": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^src-\\d+$" }
    }
  }
}
