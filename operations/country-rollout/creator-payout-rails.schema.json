{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "creator payout rails by market",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "deny_by_default",
    "gate",
    "gate_rail_agnostic",
    "assignment_point",
    "runtime_query_required",
    "visibility",
    "rails",
    "markets"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "deny_by_default": { "const": true },
    "gate": { "const": "verified_payout_account" },
    "gate_rail_agnostic": { "const": true },
    "assignment_point": { "const": "payout_account_verification" },
    "runtime_query_required": { "const": true },
    "visibility": { "const": "private_provider_legal_data" },
    "rails": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["stripe_connect", "paypal_payouts", "payoneer"] }
    },
    "markets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["market", "stripe_connect", "paypal_payouts", "payoneer", "primary_rail", "constraints"],
        "properties": {
          "market": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "stripe_connect": { "enum": ["available", "available_with_constraints", "preview", "extended_network_only", "unavailable"] },
          "paypal_payouts": { "enum": ["available", "available_with_constraints", "unavailable"] },
          "payoneer": { "enum": ["available", "unavailable"] },
          "primary_rail": { "enum": ["stripe_connect", "paypal_payouts", "payoneer"] },
          "fallback_rail": {
            "anyOf": [
              { "enum": ["stripe_connect", "paypal_payouts", "payoneer"] },
              { "type": "null" }
            ]
          },
          "constraints": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "deferred_markets": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
    },
    "out_of_scope_here": { "type": "string" }
  }
}
